# Copy this file to scripts/publish.local.env (git-ignored) and fill in real values.
# Never commit real signing identities/profile UUIDs.

# --- iOS (Ad Hoc), used by scripts/publish-ios.sh ---
# TEAM_ID and PROVISION_PROFILE_UUID are auto-detected if the downloaded Ad Hoc
# profile is placed at scripts/TodoSync.mobileprovision (git-ignored) - only
# CODESIGN_KEY needs to be set by hand below in that case.
CODESIGN_KEY=
TEAM_ID=
PROVISION_PROFILE_UUID=

# --- macOS (Developer ID Application), used by scripts/publish-macos.sh ---
MACOS_CODESIGN_IDENTITY=
