<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        iOS-ish plain button: no chrome, tinted text (system blue), like a stock UIButton.
        BasedOn FluentTheme's default Button ControlTheme for template/focus/disabled visuals.
        MinHeight/MinWidth = 44 lives here (iOS touch-target convention), not hardcoded per-button.
    -->
    <ControlTheme x:Key="PlatformButtonTheme" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="8,8" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="44" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="#007AFF" />

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#007AFF" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#3D9AFF" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
