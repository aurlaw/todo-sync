<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Todo.App.Views.AboutDialog"
        Title="About Todo"
        Width="320" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24" Spacing="8" HorizontalAlignment="Center">
        <Image Source="avares://Todo.App/Assets/AppIcon.png" Width="96" Height="96" />
        <TextBlock Text="Todo" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
        <TextBlock x:Name="VersionText" HorizontalAlignment="Center" Foreground="Gray" />
        <TextBlock Text="A personal TODO app for one user."
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240" Margin="0,12,0,0" />
        <Button Content="Close" Click="OnCloseClick" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
</Window>
