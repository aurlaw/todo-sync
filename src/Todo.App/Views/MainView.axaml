<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Todo.App.ViewModels"
             xmlns:views="using:Todo.App.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Todo.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Loaded="OnLoaded">
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:TodoEditDialogViewModel">
            <views:TodoEditView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <!--
        Icon geometries: Google Material Icons (Apache 2.0), 24x24 viewBox, used verbatim as
        PathIcon Data — Avalonia's path mini-language accepts SVG path syntax directly, including
        the lowercase relative commands these use.
    -->
    <UserControl.Resources>
        <StreamGeometry x:Key="AddIcon">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</StreamGeometry>
        <StreamGeometry x:Key="EditIcon">M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z</StreamGeometry>
        <StreamGeometry x:Key="DeleteIcon">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</StreamGeometry>
        <StreamGeometry x:Key="SettingsIcon">M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z</StreamGeometry>
    </UserControl.Resources>

    <Panel>
        <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <Button Click="OnNewClick" Theme="{DynamicResource PlatformButtonTheme}" ToolTip.Tip="New">
                    <PathIcon Data="{StaticResource AddIcon}" Width="16" Height="16" />
                </Button>
                <Button Click="OnSettingsClick" Theme="{DynamicResource PlatformButtonTheme}" ToolTip.Tip="Settings">
                    <PathIcon Data="{StaticResource SettingsIcon}" Width="16" Height="16" />
                </Button>
                <TextBlock Text="{Binding StatusMessage}" Foreground="Red" VerticalAlignment="Center" />
            </StackPanel>
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TodoItemViewModel">
                            <Border Padding="8" Margin="0,0,0,6" BorderBrush="Gray" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsDone}"
                                              MinHeight="44" MinWidth="44" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Notes}"
                                                   IsVisible="{Binding Notes, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="Gray" FontSize="12" />
                                        <TextBlock Text="{Binding DueAt, StringFormat='Due {0:MMM d, yyyy}'}"
                                                   IsVisible="{Binding DueAt, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                   Foreground="Gray" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="OnEditClick" Margin="0,0,4,0" Theme="{DynamicResource PlatformButtonTheme}" ToolTip.Tip="Edit">
                                        <PathIcon Data="{StaticResource EditIcon}" Width="16" Height="16" />
                                    </Button>
                                    <Button Grid.Column="3" Click="OnDeleteClick" Theme="{DynamicResource PlatformButtonTheme}" ToolTip.Tip="Delete">
                                        <PathIcon Data="{StaticResource DeleteIcon}" Width="16" Height="16" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <Border Background="#80000000"
                IsVisible="{Binding ActiveDialog, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <ContentControl Content="{Binding ActiveDialog}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Panel>
</UserControl>
