<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Todo.App.ViewModels"
             xmlns:views="using:Todo.App.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Todo.App.Views.MainView"
             x:DataType="vm:MainViewModel"
             Loaded="OnLoaded">
    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:TodoEditDialogViewModel">
            <views:TodoEditView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Panel>
        <DockPanel Margin="12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                <Button Content="New" Click="OnNewClick" Theme="{DynamicResource PlatformButtonTheme}" />
                <Button Content="Settings" Click="OnSettingsClick" Theme="{DynamicResource PlatformButtonTheme}" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="Red" VerticalAlignment="Center" />
            </StackPanel>
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:TodoItemViewModel">
                            <Border Padding="8" Margin="0,0,0,6" BorderBrush="Gray" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsDone}"
                                              MinHeight="44" MinWidth="44" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Notes}"
                                                   IsVisible="{Binding Notes, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                   Foreground="Gray" FontSize="12" />
                                        <TextBlock Text="{Binding DueAt, StringFormat='Due {0:MMM d, yyyy}'}"
                                                   IsVisible="{Binding DueAt, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                                                   Foreground="Gray" FontSize="12" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Edit" Click="OnEditClick" Margin="0,0,4,0" Theme="{DynamicResource PlatformButtonTheme}" />
                                    <Button Grid.Column="3" Content="Delete" Click="OnDeleteClick" Theme="{DynamicResource PlatformButtonTheme}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <Border Background="#80000000"
                IsVisible="{Binding ActiveDialog, Converter={x:Static conv:ObjectConverters.IsNotNull}}">
            <ContentControl Content="{Binding ActiveDialog}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Panel>
</UserControl>
