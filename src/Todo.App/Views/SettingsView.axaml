<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Todo.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Todo.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Width="320"
             Loaded="OnLoaded">
    <Border Background="{DynamicResource DialogBackgroundBrush}"
            BorderBrush="{DynamicResource DialogBorderBrush}" BorderThickness="1"
            Padding="16" CornerRadius="8" BoxShadow="0 4 16 0 #40000000">
        <StackPanel Spacing="10">
            <TextBlock Text="Settings" FontWeight="SemiBold" />

            <TextBlock Text="Sync server URL" />
            <TextBox Text="{Binding BaseUrl}"
                      PlaceholderText="https://your-worker.example.com" MinHeight="44" />

            <TextBlock Text="Sync API token" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding ApiToken}"
                          PlaceholderText="Paste the Worker's API token" MinHeight="44" />
                <Button Grid.Column="1" Content="Paste" Click="OnPasteClick" Theme="{DynamicResource PlatformButtonTheme}" />
            </Grid>

            <TextBlock Text="{Binding StatusMessage}"
                       IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                       Foreground="Red" FontSize="12" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Theme="{DynamicResource PlatformButtonTheme}" />
                <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" Theme="{DynamicResource PlatformButtonTheme}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
