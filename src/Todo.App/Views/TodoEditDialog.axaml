<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Todo.App.ViewModels"
        x:Class="Todo.App.Views.TodoEditDialog"
        x:DataType="vm:TodoEditDialogViewModel"
        Title="Todo"
        Width="360" SizeToContent="Height"
        CanResize="False">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock Text="Title" />
        <TextBox Text="{Binding Title}" PlaceholderText="What needs doing?" />

        <TextBlock Text="Notes" />
        <TextBox Text="{Binding Notes}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />

        <TextBlock Text="Due date" />
        <DatePicker SelectedDate="{Binding DueAt}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
