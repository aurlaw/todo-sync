<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Todo.App.ViewModels"
             x:Class="Todo.App.Views.TodoEditView"
             x:DataType="vm:TodoEditDialogViewModel"
             Width="320">
    <Border Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
            Padding="16" CornerRadius="8" BoxShadow="0 4 16 0 #40000000">
        <StackPanel Spacing="10">
            <TextBlock Text="Title" />
            <TextBox Text="{Binding Title}" PlaceholderText="What needs doing?" MinHeight="44" />

            <TextBlock Text="Notes" />
            <TextBox Text="{Binding Notes}" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />

            <TextBlock Text="Due date" />
            <DatePicker SelectedDate="{Binding DueAt}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,10,0,0">
                <Button Content="Cancel" Command="{Binding CancelCommand}" Theme="{DynamicResource PlatformButtonTheme}" />
                <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" Theme="{DynamicResource PlatformButtonTheme}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
