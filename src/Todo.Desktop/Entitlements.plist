<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Required for a .NET app to run at all under Hardened Runtime (the "runtime" codesign
        option in scripts/publish-macos.sh). Without these, the process fails to even start:
        the CLR's own libhostfxr.dylib (signed by Microsoft, not us) gets blocked by library
        validation, and CoreCLR's JIT needs the unsigned-executable-memory/JIT entitlements to
        allocate executable pages at runtime. This is Microsoft's own documented entitlement
        set for distributing .NET apps on macOS under Hardened Runtime.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
