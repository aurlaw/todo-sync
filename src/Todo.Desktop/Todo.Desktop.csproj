<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Native" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Todo.App/Todo.App.csproj" />
    <ProjectReference Include="../Todo.Core/Todo.Core.csproj" />
  </ItemGroup>

  <!--
    .NET has no built-in macOS app-bundle project type outside Mac Catalyst (out of scope here).
    Assemble a minimal Todo.app next to the build output so Info.plist/CFBundleIconFile is honored
    (Dock/Finder icon, launched via `open`). `dotnet run`/plain executable launches skip this bundle
    and show the generic terminal icon, which is expected.
  -->
  <Target Name="CreateMacOSAppBundle" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PropertyGroup>
      <AppBundleDir>$(OutDir)Todo.app</AppBundleDir>
    </PropertyGroup>
    <ItemGroup>
      <!--
        runtimes/browser-wasm/** is irrelevant leftover multi-RID native-asset content (a
        SkiaSharp/HarfBuzzSharp packaging quirk — their native assets for every platform get
        copied to the output dir regardless of the actual build target, not filtered to osx).
        Left in, codesign's deep-sign mode (scripts/publish-macos.sh) fails with "bundle format
        unrecognized, invalid, or unsuitable" trying to sign it as a nested bundle — it isn't
        one, so exclude it from the app bundle entirely rather than working around codesign.
      -->
      <AppBundleContents Include="$(OutDir)**\*" Exclude="$(OutDir)Todo.app\**\*;$(OutDir)runtimes\browser-wasm\**\*" />
    </ItemGroup>
    <MakeDir Directories="$(AppBundleDir)/Contents/MacOS;$(AppBundleDir)/Contents/Resources" />
    <Copy SourceFiles="Info.plist" DestinationFolder="$(AppBundleDir)/Contents" />
    <Copy SourceFiles="../../_appicon/AppIcon.icns" DestinationFolder="$(AppBundleDir)/Contents/Resources" />
    <Copy SourceFiles="@(AppBundleContents)" DestinationFolder="$(AppBundleDir)/Contents/MacOS/%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
